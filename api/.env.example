# Railway provides DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgres://user:pass@localhost:5432/mealdrop

# Set true on Railway (managed Postgres wants TLS); leave unset locally.
# PGSSL=true

# Optional fixed drop time (ISO 8601). If unset, defaults to boot + 15 min,
# and can be rescheduled anytime via POST /reset { drop_in_seconds }.
# DROP_TIME=2026-07-18T19:00:00Z

# Secret for POST /reset (dev/re-run tool).
RESET_SECRET=hooah

PORT=3000
